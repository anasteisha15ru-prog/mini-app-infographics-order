# Telegram Bot
BOT_TOKEN=123456789:YOUR_BOT_TOKEN

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Public app URL
WEBAPP_URL=https://your-app.up.railway.app

# Куда бот будет отправлять новые заказы
# Обычно это ваш Telegram user id, если хотите получать в личку
ADMIN_CHAT_ID=123456789

# Кто может нажимать inline-кнопки в Telegram
# Можно указать несколько id через запятую
ADMIN_USER_IDS=123456789
DESIGNER_USER_IDS=

# Вход в веб-админку /admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_strong_password

# Секрет для Telegram webhook
# Придумывается вручную
TELEGRAM_WEBHOOK_SECRET=your-long-random-secret

# Порт для локального запуска / Railway
PORT=3000

# Разрешить тестировать форму в обычном браузере, не из Telegram
# На проде лучше false
ALLOW_UNSAFE_TEST_MODE=false

# Используется только если ALLOW_UNSAFE_TEST_MODE=true
TEST_USER_ID=123456789